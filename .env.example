# Example environment variables for Nelson Global Fixture Management Software
# Copy this file to `.env` and replace the placeholders with your own values.

# Client-safe Supabase values (public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only Supabase values (secret)
EXTERNAL_SUPABASE_URL=https://your-project.supabase.co
EXTERNAL_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# One-time admin bootstrap setup key
EXTERNAL_DB_PASSWORD=your-bootstrap-setup-key

# Optional
